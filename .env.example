# Google Gemini API Key (required)
GOOGLE_API_KEY=your-api-key-here

# Model configuration (optional — sensible defaults provided)
DREAMER_MODEL=gemini-2.0-pro-exp
JUDGE_MODEL=gemini-1.5-pro
EXECUTOR_MODEL=gemini-2.0-flash

# Temporal configuration (optional — needed for durable execution)
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default

# Dream schedule (optional — defaults to every 6 hours)
DREAM_INTERVAL_HOURS=6

# Consolidation schedule (optional — defaults to 03:00 UTC)
CONSOLIDATION_HOUR_UTC=3

# Embedding backend for episodic memory (optional — Phase 2)
# Options: sentence-transformers (default, local MiniLM-L6-v2),
#          ollama (local nomic-embed-text via Ollama),
#          gemini (cloud fallback)
EMBEDDING_BACKEND=sentence-transformers

# --- LLM Router (optional — add-specialized-llm-router) ---
# Set to "on" to enable declarative model selection across Trinity agents.
# When "off" (default), agents use the legacy hardcoded models above.
DANTE_ROUTER=off

# Ollama host for local Nemotron / Gemma 4 (only matters when router is on)
OLLAMA_HOST=http://localhost:11434
